--- a/drivers/gpu/drm/msm/adreno/adreno_gpu.c
+++ b/drivers/gpu/drm/msm/adreno/adreno_gpu.c
@@ -11,6 +11,7 @@
 #include <linux/qcom_scm.h>
 #include <linux/kernel.h>
 #include <linux/of_address.h>
+#include <linux/of.h>
 #include <linux/pm_opp.h>
 #include <linux/slab.h>
 #include <linux/soc/qcom/mdt_loader.h>
@@ -30,6 +31,8 @@
 #include "a6xx_gpu_state.h"
 #include "a7xx_gpu.h"

+extern bool tepuy_game_mode;
+
 /*
  * *really* sad.  This is broken / missing from qcom-scm.h
  * (along with a lot of other stuff, qcom-scm.h is mostly a stub
@@ -971,6 +974,22 @@ static int adreno_gpu_init(struct msm_gpu *gpu)
 			DRM_DEV_ERROR(dev, "Unable to set the OPP table\n");
 	}

+	/*
+	 * The SM8635/Adreno 735 hardware supports a 1100 MHz GPU point.
+	 * HyperOS vendor DTs can omit that point while AOSP exposes it.
+	 * Only add the missing OPP when game mode is active.
+	 */
+	if (!ret && of_machine_is_compatible("xiaomi,peridot") && tepuy_game_mode) {
+		struct dev_pm_opp *opp;
+		opp = dev_pm_opp_add(dev, 1100000000UL, 0);
+		if (IS_ERR(opp)) {
+			if (PTR_ERR(opp) != -EEXIST)
+				DRM_DEV_DEBUG(dev, "Failed to add 1100 MHz peridot GPU OPP: %ld\n", PTR_ERR(opp));
+		} else {
+			dev_pm_opp_put(opp);
+		}
+	}
+
 	if (!ret) {
 		/* Find the fastest defined rate */
 		opp = dev_pm_opp_find_freq_floor(dev, &freq);

diff --git a/drivers/gpu/drm/msm/adreno/a6xx_gmu.c b/drivers/gpu/drm/msm/adreno/a6xx_gmu.c
--- a/drivers/gpu/drm/msm/adreno/a6xx_gmu.c
+++ b/drivers/gpu/drm/msm/adreno/a6xx_gmu.c
@@ -30,6 +30,8 @@
 #include "msm_gem.h"
 #include "msm_mmu.h"

+extern bool tepuy_game_mode;
+
 #define GPU_HW_ACK_TIMEOUT_MS 100
 /*
  * These are the different values for the lowest cache
@@ -117,10 +119,27 @@ static void a6xx_gmu_set_freq(struct msm_gpu *gpu, struct dev_pm_opp *opp,
 	if (gpu_freq == gmu->freq)
 		return;

-	for (perf_index = 0; perf_index < gmu->nr_gpu_freqs - 1; perf_index++)
+	for (perf_index = 0; perf_index < gmu->nr_gpu_freqs; perf_index++)
 		if (gpu_freq == gmu->gpu_freqs[perf_index])
 			break;

+	if (perf_index == gmu->nr_gpu_freqs) {
+		DRM_DEV_ERROR(gmu->dev, "GPU frequency %lu Hz is not in the GMU table\n",
+			      gpu_freq);
+		return;
+	}
+
+	/*
+	 * When game mode is inactive, cap the GPU at the second-highest
+	 * frequency to save battery.  The highest point (usually 1100 MHz on
+	 * peridot) is reserved for game mode.
+	 */
+	if (!tepuy_game_mode && perf_index == gmu->nr_gpu_freqs - 1) {
+		DRM_DEV_DEBUG(gmu->dev, "Tepuy GameMode off, capping GPU perf index\n");
+		perf_index = gmu->nr_gpu_freqs - 2;
+	}
+
 	gmu->current_perf_index = perf_index;
 	gmu->freq = gmu->gpu_freqs[perf_index];
